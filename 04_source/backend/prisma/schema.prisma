generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Agent {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  status      String   @default("idle")
  // AI-agent management attributes
  role        String   @default("")
  persona     String   @default("")
  skills      String   @default("") // comma-separated; DTO exposes string[]
  gender      String   @default("unspecified")
  importance  String   @default("medium")
  model       String   @default("")
  goal        String   @default("")
  context     String   @default("") // standing knowledge injected into every run
  memory      Boolean  @default(false) // inject summaries of recent runs
  createdAt   DateTime @default(now())

  runs          AgentRun[]
  pipelineSteps PipelineStep[]

  @@map("agents")
}

// An ordered chain of agents: each step's output becomes the next step's input.
// Triggers automate the chain: manual (Run button), interval (scheduler fires
// defaultTask every intervalSec), webhook (POST /api/hooks/:webhookKey).
model Pipeline {
  id              String    @id @default(uuid())
  name            String    @unique
  description     String    @default("")
  triggerType     String    @default("manual") // manual | interval | webhook
  intervalSec     Int       @default(0)
  defaultTask     String    @default("") // task used by interval/webhook runs
  enabled         Boolean   @default(true)
  webhookKey      String?   @unique // nullable: backfilled on save for old rows
  lastTriggeredAt DateTime?
  createdAt       DateTime  @default(now())

  steps PipelineStep[]
  edges PipelineEdge[]
  runs  PipelineRun[]

  @@map("pipelines")
}

model PipelineStep {
  id          String   @id @default(uuid())
  pipelineId  String
  pipeline    Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  order       Int
  nodeType    String   @default("agent") // agent | logic | skill | http
  agentId     String? // only agent nodes; SetNull keeps the node when the agent goes
  agent       Agent?   @relation(fields: [agentId], references: [id], onDelete: SetNull)
  instruction String   @default("") // optional per-step directive prepended to the input
  config      String   @default("{}") // per-type settings (logic op/value, skill preset, http url)
  posX        Int      @default(0) // canvas layout (n8n-style editor)
  posY        Int      @default(0)

  outgoing PipelineEdge[] @relation("edgeFrom")
  incoming PipelineEdge[] @relation("edgeTo")

  @@index([pipelineId])
  @@map("pipeline_steps")
}

// Explicit connections between steps. `branch` is set on edges leaving a logic
// node ("true"/"false"); plain edges use "".
model PipelineEdge {
  id         String       @id @default(uuid())
  pipelineId String
  pipeline   Pipeline     @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  fromId     String
  from       PipelineStep @relation("edgeFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toId       String
  to         PipelineStep @relation("edgeTo", fields: [toId], references: [id], onDelete: Cascade)
  branch     String       @default("")

  @@index([pipelineId])
  @@map("pipeline_edges")
}

// One execution of a pipeline. Step runs snapshot agent name/instruction so the
// record stays readable even if the pipeline or agents change later.
model PipelineRun {
  id         String   @id @default(uuid())
  pipelineId String
  pipeline   Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  task       String
  trigger    String   @default("manual") // what fired this run: manual | interval | webhook
  graph      String   @default("[]") // snapshot of edges as [{from,to,branch}] over step order
  output     String   @default("") // final output = last executed step's output
  status     String   @default("running") // running | succeeded | failed
  error      String   @default("")
  durationMs Int      @default(0)
  createdAt  DateTime @default(now())

  steps PipelineStepRun[]

  @@index([pipelineId])
  @@map("pipeline_runs")
}

model PipelineStepRun {
  id            String      @id @default(uuid())
  pipelineRunId String
  pipelineRun   PipelineRun @relation(fields: [pipelineRunId], references: [id], onDelete: Cascade)
  order         Int
  nodeType      String      @default("agent")
  agentId       String      @default("")
  agentName     String // display label: agent name, or "IF …" / "Skill: …" / "HTTP …"
  instruction   String      @default("")
  config        String      @default("{}")
  model         String      @default("")
  task          String      @default("") // composed input this step actually received
  output        String      @default("")
  status        String      @default("pending") // pending | running | succeeded | failed | skipped
  error         String      @default("")
  durationMs    Int         @default(0)
  createdAt     DateTime    @default(now())

  @@index([pipelineRunId])
  @@map("pipeline_step_runs")
}

// One execution of an agent against a task. Runs asynchronously: created in
// `running`, then the executor fills output/status. Frontend polls until done.
model AgentRun {
  id         String   @id @default(uuid())
  agentId    String
  agent      Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  task       String
  output     String   @default("")
  status     String   @default("running") // running | succeeded | failed
  model      String   @default("")         // model actually used for this run
  error      String   @default("")
  durationMs Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([agentId])
  @@map("agent_runs")
}
