generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Agent {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  status      String   @default("idle")
  // AI-agent management attributes
  role        String   @default("")
  persona     String   @default("")
  skills      String   @default("") // comma-separated; DTO exposes string[]
  gender      String   @default("unspecified")
  importance  String   @default("medium")
  model       String   @default("")
  goal        String   @default("")
  createdAt   DateTime @default(now())

  runs        AgentRun[]

  @@map("agents")
}

// One execution of an agent against a task. Runs asynchronously: created in
// `running`, then the executor fills output/status. Frontend polls until done.
model AgentRun {
  id         String   @id @default(uuid())
  agentId    String
  agent      Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  task       String
  output     String   @default("")
  status     String   @default("running") // running | succeeded | failed
  model      String   @default("")         // model actually used for this run
  error      String   @default("")
  durationMs Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([agentId])
  @@map("agent_runs")
}
