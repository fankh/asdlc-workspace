generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Agent {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  status      String   @default("idle")
  createdAt   DateTime @default(now())

  @@map("agents")
}
