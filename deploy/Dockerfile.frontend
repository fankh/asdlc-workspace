# Build the Vite app, serve via nginx with /api proxied to the backend.
FROM node:20-alpine AS build
WORKDIR /app
COPY 04_source/frontend/package.json 04_source/frontend/package-lock.json* ./
RUN npm install
COPY 04_source/frontend/ ./
RUN npm run build

FROM nginx:1.27-alpine
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
